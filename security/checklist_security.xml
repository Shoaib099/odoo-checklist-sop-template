<odoo>

    <!-- Module category -->
    <record id="module_category_checklist" model="ir.module.category">
        <field name="name">Checklist</field>
        <field name="description">Checklist and SOP management</field>
        <field name="sequence">50</field>
    </record>

    <!-- Odoo 19 privilege -->
    <record id="privilege_checklist" model="res.groups.privilege">
        <field name="name">Checklist</field>
        <field name="category_id" ref="module_category_checklist"/>
    </record>

    <!-- Checklist User -->
    <record id="group_checklist_user" model="res.groups">
        <field name="name">User</field>
        <field name="privilege_id" ref="privilege_checklist"/>
    </record>

    <!-- Checklist Manager -->
    <record id="group_checklist_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="privilege_id" ref="privilege_checklist"/>
        <field name="implied_ids" eval="[(4, ref('group_checklist_user'))]"/>
    </record>

</odoo>